PROJECT_NAME=FormFoundry
ENVIRONMENT=local
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=formfoundry
POSTGRES_USER=formfoundry
POSTGRES_PASSWORD=formfoundry%40123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis%40123

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=formfoundry
MINIO_SECRET_KEY=formfoundry123
MINIO_SECURE=false
MINIO_BUCKET=formfoundry-assets

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-local-key

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.storage
AUTO_RUN_JOBS=true
RESOLUTION_THRESHOLD=0.78
LOW_CONFIDENCE_THRESHOLD=0.6

LLM_ENABLED=true
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
VISION_MODEL=gpt-4.1-mini
VISION_BASE_URL=
VISION_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1
PDF_OCR_MAX_PAGES=10
