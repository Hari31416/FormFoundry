PROJECT_NAME=FormFoundry
ENVIRONMENT=local
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=formfoundry
POSTGRES_USER=formfoundry
POSTGRES_PASSWORD=formfoundry%40123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis%40123

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=formfoundry
S3_SECRET_KEY=formfoundry123
S3_SECURE=false
S3_BUCKET=formfoundry-assets

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-local-key

STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=.storage
AUTO_RUN_JOBS=true
RESOLUTION_THRESHOLD=0.78
LOW_CONFIDENCE_THRESHOLD=0.6

LLM_ENABLED=true
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
VISION_MODEL=gpt-4.1-mini
VISION_BASE_URL=
VISION_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1
PDF_OCR_MAX_PAGES=10

# Language & Speech Services (Options: Bhashini, Sarvam, Google, langdetect, None)
LANGUAGE_DETECTION_SERVICE_PROVIDER=langdetect
LANGUAGE_TRANSLATION_SERVICE_PROVIDER=Google
TTS_SERVICE_PROVIDER=
STT_SERVICE_PROVIDER=

# Bhashini API Credentials & Configurations
BHASHINI_API_KEY=
BHASHINI_ENDPOINT_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_LANG_DETECTION_SERVICE_ID=
BHASHINI_TRANSLATION_SERVICE_ID=ai4bharat/indictrans-v2-all-gpu--t4

# Sarvam API Credentials & Configurations
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_TRANSLATION_MODE=formal
SARVAM_NUMERALS_FORMAT=international
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_AUDIO_CODEC=mp3
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TIMEOUT_SECONDS=15
